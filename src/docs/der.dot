
      graph {
         graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.8, bgcolor=white];
         node [label="\N", shape=plaintext];
         edge [color=gray50, minlen=2, style=dashed];     
"parque_movil" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">parque_movil</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><u><FONT>IDParqueMovil</FONT></u> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT"><FONT>A_oCNRT</FONT> <FONT> [SMALLINT]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Actual</FONT> <FONT> [DATE]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>AireAcond</FONT> <FONT> [BOOLEAN]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Anterior</FONT> <FONT> [DATE]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Asientos</FONT> <FONT> [SMALLINT]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Carroceria</FONT> <FONT> [VARCHAR(30)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>ChasisA_o</FONT> <FONT> [SMALLINT]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>ChasisCod</FONT> <FONT> [VARCHAR(60)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>CodCNRT</FONT> <FONT> [SMALLINT]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Dominio</FONT> <FONT> [VARCHAR(7)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Estado</FONT> <FONT> [VARCHAR(15)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>EstadoHabilitacion</FONT> <FONT> [VARCHAR(7)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>FechaCNRT</FONT> <FONT> [DATE]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>FechaPatentado</FONT> <FONT> [DATE]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>HabilitacionCNRT</FONT> <FONT> [VARCHAR(40)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>IDAseguradora</FONT> <FONT> [INTEGER]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>IDChasis</FONT> <FONT> [INTEGER]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>IDMotor</FONT> <FONT> [INTEGER]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Interno</FONT> <FONT> [SMALLINT]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>KM</FONT> <FONT> [NUMERIC(10, 2)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Linea</FONT> <FONT> [SMALLINT]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>MotorCod</FONT> <FONT> [VARCHAR(60)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Observacion</FONT> <FONT> [VARCHAR(200)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Prendado</FONT> <FONT> [BOOLEAN]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>TipoCombustible</FONT> <FONT> [VARCHAR(9)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>TipoHabilitacion</FONT> <FONT> [VARCHAR(3)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>TipoServicio</FONT> <FONT> [VARCHAR(15)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Titular</FONT> <FONT> [VARCHAR(30)]</FONT></TD></TR></TABLE></FONT>>];

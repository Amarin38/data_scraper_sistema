]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>MotorCod</FONT> <FONT> [VARCHAR(60)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Observacion</FONT> <FONT> [VARCHAR(200)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Prendado</FONT> <FONT> [BOOLEAN]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>TipoCombustible</FONT> <FONT> [VARCHAR(9)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>TipoHabilitacion</FONT> <FONT> [VARCHAR(3)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>TipoServicio</FONT> <FONT> [VARCHAR(15)]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT>Titular</FONT> <FONT> [VARCHAR(30)]</FONT></TD></TR></TABLE></FONT>>];
